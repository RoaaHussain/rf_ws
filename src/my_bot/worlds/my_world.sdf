<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lidar_test_arena">

    <!-- Core systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer boundary walls -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 20 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>50 0.4 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>50 0.4 3</size></box></geometry><material><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -20 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>50 0.4 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>50 0.4 3</size></box></geometry><material><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>25 0 1.5 0 0 1.570796</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40 0.4 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>40 0.4 3</size></box></geometry><material><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-25 0 1.5 0 0 1.570796</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40 0.4 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>40 0.4 3</size></box></geometry><material><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Internal maze walls -->
    <model name="maze_wall_1">
      <static>true</static>
      <pose>8 8 1.5 0 0 0.8</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>15 0.4 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>15 0.4 3</size></box></geometry><material><diffuse>0.7 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="maze_wall_2">
      <static>true</static>
      <pose>-10 -5 1.5 0 0 -0.6</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.4 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.4 3</size></box></geometry><material><diffuse>0.7 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Test objects -->
    <model name="red_box">
      <static>true</static>
      <pose>5 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 1.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 1.2 1</size></box></geometry><material><diffuse>0.9 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="blue_cylinder">
      <static>true</static>
      <pose>-8 12 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.8</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.8</radius><length>1.2</length></cylinder></geometry><material><diffuse>0.2 0.5 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="green_box">
      <static>true</static>
      <pose>12 -10 0.5 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2 1 1</size></box></geometry><material><diffuse>0.2 0.8 0.3 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>