<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Include directly rather than relying on parent-file include order -->
    <xacro:include filename="inertial_macros.xacro"/>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.0325" length="0.012"/>
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.0325" length="0.012"/>
            </geometry>
        </collision>

        <xacro:inertial_cylinder mass="0.01" length="0.012" radius="0.0325">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="laser_frame">
        <material>Gazebo/Red</material>

        <sensor name="lidar" type="gpu_lidar">
            <!-- No relative_to: this sensor is already scoped to laser_frame
                 via <gazebo reference="laser_frame">, so default pose is
                 relative to laser_frame itself. -->
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <!-- Must match an actual URDF link so RViz/SLAM can resolve the
                 scan's TF frame. -->
            <gz_frame_id>laser_frame</gz_frame_id>

            <lidar>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>

</robot>



